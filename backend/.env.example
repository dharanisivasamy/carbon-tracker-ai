PORT=5000
HOST=0.0.0.0
# MongoDB connection URI (local: mongodb://localhost:27017/carbon_tracker or cloud Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/carbon_tracker)
MONGO_URI=mongodb://localhost:27017/carbon_tracker
JWT_SECRET=replace_with_a_strong_random_secret
# Single origin or comma-separated list of allowed web origins (e.g. http://localhost:3000,https://your-app.web.app)
CLIENT_URL=http://localhost:3000
ML_INFERENCE_URL=http://127.0.0.1:8000

# Firebase credentials (choose ONE method):
# 1. Local development: absolute path to local service-account JSON file
GOOGLE_APPLICATION_CREDENTIALS=
# 2. Cloud production: full JSON string or base64 string of service-account credentials
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

