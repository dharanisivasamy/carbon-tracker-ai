<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Development backend addresses are supplied with API_BASE_URL and may
      change with the LAN. Permit HTTP here so a physical device can reach a
      development server. Production builds should use an HTTPS API and may
      replace this with a domain-specific policy.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
